<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="WrapTune"
    Manufacturer="thefinder808"
    Version="$(var.Version)"
    UpgradeCode="B7E4F831-2D0A-4C5F-9E8A-1A3B5C7D9E0F"
    Compressed="yes"
    Scope="perMachine"
    InstallerVersion="500">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of WrapTune is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Install to Program Files\WrapTune -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WrapTune">

        <Component Id="MainExecutable" Guid="D1A2B3C4-5E6F-7A8B-9C0D-E1F2A3B4C5D6" Bitness="always64">
          <File Id="WrapTune.exe"
                Source="..\bin\Release\net8.0-windows\win-x64\publish\WrapTune.exe"
                KeyPath="yes" />
        </Component>

        <Component Id="ContentPrepTool" Guid="A9B8C7D6-E5F4-3A2B-1C0D-F9E8D7C6B5A4" Bitness="always64">
          <File Id="IntuneWinAppUtil.exe"
                Source="Bundled\IntuneWinAppUtil.exe"
                KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="WrapTune">
        <Component Id="StartMenuShortcut" Guid="C3D4E5F6-A7B8-9C0D-1E2F-3A4B5C6D7E8F">
          <Shortcut Id="AppShortcut"
                    Name="WrapTune"
                    Target="[INSTALLFOLDER]WrapTune.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\WrapTune"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Desktop shortcut (optional, toggled by checkbox in OptionsDlg) -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="E5F6A7B8-C9D0-1E2F-3A4B-5C6D7E8F9A0B" Condition="INSTALLDESKTOPSHORTCUT" Transitive="yes">
        <Shortcut Id="DesktopAppShortcut"
                  Name="WrapTune"
                  Target="[INSTALLFOLDER]WrapTune.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\WrapTune"
                       Name="desktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Icon Id="AppIcon" SourceFile="..\bin\Release\net8.0-windows\win-x64\publish\WrapTune.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Desktop shortcut property — checked by default, toggled by OptionsDlg checkbox -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <!-- Installer UI: Welcome → License → Folder picker → Options (checkbox) → Ready → Progress → Complete -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Insert OptionsDlg between InstallDirDlg and VerifyReadyDlg -->
    <UI>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Order="200" Condition="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="200" Condition="1" />
    </UI>

    <!-- Features -->
    <Feature Id="MainFeature" Title="WrapTune" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ContentPrepTool" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

  </Package>
</Wix>
