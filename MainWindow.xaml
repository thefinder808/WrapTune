<Window x:Class="WrapTune.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WrapTune"
        Width="720" Height="640" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Label for form rows: right-aligned, dim, with optional flag hint -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Dimmer}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style x:Key="BrowseBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Content" Value="…"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource Panel2Bg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentOn}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ThemeToggle" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 Header -->
            <RowDefinition Height="Auto"/>   <!-- 1 Tool pill -->
            <RowDefinition Height="Auto"/>   <!-- 2 Form -->
            <RowDefinition Height="Auto"/>   <!-- 3 Toggle row -->
            <RowDefinition Height="*"/>      <!-- 4 Output log -->
            <RowDefinition Height="Auto"/>   <!-- 5 Footer -->
        </Grid.RowDefinitions>

        <!-- ── 0 · Header ───────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="New package" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg}"/>
                <TextBlock Margin="0,3,0,0" FontSize="12.5"
                           Foreground="{DynamicResource Dim}">
                    <Run Text="Wrap a Win32 installer into an "/>
                    <Run FontFamily="Consolas" Foreground="{DynamicResource Accent}" Text=".intunewin"/>
                    <Run Text=" package for Microsoft Intune."/>
                </TextBlock>
            </StackPanel>
            <Button x:Name="BtnTheme" Grid.Column="1" Style="{StaticResource ThemeToggle}"
                    Content="◐ Dark" Click="BtnTheme_Click" VerticalAlignment="Top"/>
        </Grid>

        <!-- ── 1 · Tool-detected pill ───────────────────────────────── -->
        <Border Grid.Row="1" Margin="0,0,0,16"
                Background="{DynamicResource AccentSoft}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource Fg}" Text="IntuneWinAppUtil"/>
                <TextBox x:Name="TxtExePath" Grid.Column="2" Margin="14,0,0,0"
                         Style="{StaticResource PathBox}" Height="26"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Dim}"
                         PreviewDragOver="FileDrag_PreviewDragOver" Drop="FileDrop_Drop"/>
                <Button x:Name="BtnBrowseExe" Grid.Column="3"
                        Style="{StaticResource BrowseBtn}" Click="BtnBrowseExe_Click"/>
            </Grid>
        </Border>

        <!-- ── 2 · Form rows ────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Source folder -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,10" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Source folder"/>
                <TextBlock Style="{StaticResource FieldHint}" Text="-c"/>
            </StackPanel>
            <TextBox x:Name="TxtSourceFolder" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                     Style="{StaticResource PathBox}"
                     PreviewDragOver="FolderDrag_PreviewDragOver" Drop="SourceFolderDrop_Drop"/>
            <Button x:Name="BtnBrowseSource" Grid.Row="0" Grid.Column="2" Margin="6,0,0,10"
                    Style="{StaticResource BrowseBtn}" Click="BtnBrowseSource_Click"/>

            <!-- Setup file -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,10" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Setup file"/>
                <TextBlock Style="{StaticResource FieldHint}" Text="-s"/>
            </StackPanel>
            <TextBox x:Name="TxtSetupFile" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                     Style="{StaticResource PathBox}"
                     PreviewDragOver="FileDrag_PreviewDragOver" Drop="FileDrop_Drop"/>
            <Button x:Name="BtnBrowseSetup" Grid.Row="1" Grid.Column="2" Margin="6,0,0,10"
                    Style="{StaticResource BrowseBtn}" Click="BtnBrowseSetup_Click"/>

            <!-- Output folder -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,10" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder"/>
                <TextBlock Style="{StaticResource FieldHint}" Text="-o"/>
            </StackPanel>
            <TextBox x:Name="TxtOutputFolder" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                     Style="{StaticResource PathBox}"
                     PreviewDragOver="FolderDrag_PreviewDragOver" Drop="FolderDrop_Drop"/>
            <Button x:Name="BtnBrowseOutput" Grid.Row="2" Grid.Column="2" Margin="6,0,0,10"
                    Style="{StaticResource BrowseBtn}" Click="BtnBrowseOutput_Click"/>

            <!-- Catalog folder (optional) -->
            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Catalog folder"/>
                <TextBlock Style="{StaticResource FieldHint}" Text="-a · optional"/>
            </StackPanel>
            <TextBox x:Name="TxtCatalogFolder" Grid.Row="3" Grid.Column="1"
                     Style="{StaticResource PathBox}"
                     PreviewDragOver="FolderDrag_PreviewDragOver" Drop="FolderDrop_Drop"/>
            <Button x:Name="BtnBrowseCatalog" Grid.Row="3" Grid.Column="2" Margin="6,0,0,0"
                    Style="{StaticResource BrowseBtn}" Click="BtnBrowseCatalog_Click"/>
        </Grid>

        <!-- ── 3 · Overwrite toggle ─────────────────────────────────── -->
        <CheckBox x:Name="ChkOverwrite" Grid.Row="3"
                  Margin="142,14,0,16" IsChecked="True"
                  Foreground="{DynamicResource Fg}" FontSize="12.5"
                  VerticalContentAlignment="Center">
            <CheckBox.Content>
                <TextBlock>
                    <Run Text="Overwrite existing output "/>
                    <Run FontFamily="Consolas" Foreground="{DynamicResource Dimmer}" FontSize="11" Text="-q"/>
                </TextBlock>
            </CheckBox.Content>
        </CheckBox>

        <!-- ── 4 · Output log ───────────────────────────────────────── -->
        <Border Grid.Row="4" Margin="0,0,0,14"
                Background="{DynamicResource LogBg}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                CornerRadius="8">
            <TextBox x:Name="TxtOutput"
                     Background="Transparent" BorderThickness="0"
                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11.5"
                     Foreground="{DynamicResource Dim}"
                     Padding="12"/>
        </Border>

        <!-- ── 5 · Footer ───────────────────────────────────────────── -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Ready"
                       VerticalAlignment="Center"
                       FontSize="11.5" Foreground="{DynamicResource Dimmer}"/>
            <Button x:Name="BtnOpenOutput" Grid.Column="1" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryBtn}"
                    Content="Open output" Visibility="Collapsed"
                    Click="BtnOpenOutput_Click"/>
            <Button x:Name="BtnPackage" Grid.Column="2"
                    Style="{StaticResource PrimaryBtn}"
                    Content="Package" Click="BtnPackage_Click"/>
        </Grid>
    </Grid>
</Window>
