<Window x:Class="WrapTune.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WrapTune"
        Width="720" Height="620" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#1a2332">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#8ba3b5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="TextBox" x:Key="PathBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#223044"/>
            <Setter Property="Foreground" Value="#f1faee"/>
            <Setter Property="BorderBrush" Value="#2d4a5e"/>
            <Setter Property="BorderThickness" Value="2,1,1,1"/>
            <Setter Property="Padding" Value="6,2,4,2"/>
            <Setter Property="AllowDrop" Value="True"/>
        </Style>
        <Style TargetType="Button" x:Key="BrowseBtn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Content" Value="…"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#223044"/>
            <Setter Property="Foreground" Value="#8ba3b5"/>
            <Setter Property="BorderBrush" Value="#2d4a5e"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Exe path -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Label DockPanel.Dock="Top" Content="IntuneWinAppUtil.exe Path"/>
            <Button x:Name="BtnBrowseExe" DockPanel.Dock="Right" Style="{StaticResource BrowseBtn}" Margin="6,0,0,0" Click="BtnBrowseExe_Click"/>
            <TextBox x:Name="TxtExePath" Style="{StaticResource PathBox}" PreviewDragOver="FileDrag_PreviewDragOver" Drop="FileDrop_Drop"/>
        </DockPanel>

        <!-- Row 1: Source Folder -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <Label DockPanel.Dock="Top" Content="Source Folder (-c)"/>
            <Button x:Name="BtnBrowseSource" DockPanel.Dock="Right" Style="{StaticResource BrowseBtn}" Margin="6,0,0,0" Click="BtnBrowseSource_Click"/>
            <TextBox x:Name="TxtSourceFolder" Style="{StaticResource PathBox}" PreviewDragOver="FolderDrag_PreviewDragOver" Drop="SourceFolderDrop_Drop"/>
        </DockPanel>

        <!-- Row 2: Setup File -->
        <DockPanel Grid.Row="2" Margin="0,0,0,6">
            <Label DockPanel.Dock="Top" Content="Setup File (-s)"/>
            <Button x:Name="BtnBrowseSetup" DockPanel.Dock="Right" Style="{StaticResource BrowseBtn}" Margin="6,0,0,0" Click="BtnBrowseSetup_Click"/>
            <TextBox x:Name="TxtSetupFile" Style="{StaticResource PathBox}" PreviewDragOver="FileDrag_PreviewDragOver" Drop="FileDrop_Drop"/>
        </DockPanel>

        <!-- Row 3: Output Folder -->
        <DockPanel Grid.Row="3" Margin="0,0,0,6">
            <Label DockPanel.Dock="Top" Content="Output Folder (-o)"/>
            <Button x:Name="BtnBrowseOutput" DockPanel.Dock="Right" Style="{StaticResource BrowseBtn}" Margin="6,0,0,0" Click="BtnBrowseOutput_Click"/>
            <TextBox x:Name="TxtOutputFolder" Style="{StaticResource PathBox}" PreviewDragOver="FolderDrag_PreviewDragOver" Drop="FolderDrop_Drop"/>
        </DockPanel>

        <!-- Row 4: Catalog Folder (optional) -->
        <DockPanel Grid.Row="4" Margin="0,0,0,6">
            <Label DockPanel.Dock="Top" Content="Catalog Folder (-a)  [optional]"/>
            <Button x:Name="BtnBrowseCatalog" DockPanel.Dock="Right" Style="{StaticResource BrowseBtn}" Margin="6,0,0,0" Click="BtnBrowseCatalog_Click"/>
            <TextBox x:Name="TxtCatalogFolder" Style="{StaticResource PathBox}" PreviewDragOver="FolderDrag_PreviewDragOver" Drop="FolderDrop_Drop"/>
        </DockPanel>

        <!-- Row 5: Options -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,8">
            <CheckBox x:Name="ChkOverwrite" Content="Overwrite existing output (-q)" Foreground="#f1faee" FontSize="12.5" VerticalContentAlignment="Center" IsChecked="True"/>
        </StackPanel>

        <!-- Row 6: Action buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnPackage" Content="  Package  " Height="34" Width="120" FontSize="14" FontWeight="SemiBold"
                    Background="#2d8b8b" Foreground="#f1faee" BorderBrush="#247272" Click="BtnPackage_Click"/>
            <Button x:Name="BtnOpenOutput" Content="  Open Output Folder  " Height="34" Width="170" FontSize="12.5"
                    Background="#223044" Foreground="#8ba3b5" BorderBrush="#2d4a5e" Margin="12,0,0,0" Visibility="Collapsed" Click="BtnOpenOutput_Click"/>
        </StackPanel>

        <!-- Row 7: Output log -->
        <TextBox x:Name="TxtOutput" Grid.Row="7"
                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11.5"
                 Background="#131c29" Foreground="#a8dadc" BorderBrush="#2d4a5e"
                 Padding="6"/>

        <!-- Row 8: Status bar -->
        <TextBlock x:Name="TxtStatus" Grid.Row="8" Foreground="#8ba3b5" FontSize="11" Margin="0,6,0,0" Text="Ready"/>
    </Grid>
</Window>
