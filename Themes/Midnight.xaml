<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Midnight palette (dark mode) -->
    <Color x:Key="WindowBgColor">#FF0F1822</Color>
    <Color x:Key="PanelBgColor">#FF172230</Color>
    <Color x:Key="Panel2BgColor">#FF1D2A3A</Color>
    <Color x:Key="LogBgColor">#FF0A1118</Color>
    <Color x:Key="BorderColor">#FF27384E</Color>
    <Color x:Key="BorderSoftColor">#FF1F2D40</Color>
    <Color x:Key="FgColor">#FFE7EEF6</Color>
    <Color x:Key="DimColor">#FF8094AB</Color>
    <Color x:Key="DimmerColor">#FF566A82</Color>
    <Color x:Key="AccentColor">#FF5EEAD4</Color>
    <Color x:Key="AccentSoftColor">#FF152C36</Color>
    <Color x:Key="AccentOnColor">#FF073B36</Color>
    <Color x:Key="SuccessColor">#FF52C7A0</Color>
    <Color x:Key="ErrorColor">#FFE06C60</Color>

    <SolidColorBrush x:Key="WindowBg" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="PanelBg" Color="{StaticResource PanelBgColor}"/>
    <SolidColorBrush x:Key="Panel2Bg" Color="{StaticResource Panel2BgColor}"/>
    <SolidColorBrush x:Key="LogBg" Color="{StaticResource LogBgColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}"/>
    <SolidColorBrush x:Key="Fg" Color="{StaticResource FgColor}"/>
    <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}"/>
    <SolidColorBrush x:Key="Dimmer" Color="{StaticResource DimmerColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentOn" Color="{StaticResource AccentOnColor}"/>
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}"/>

    <!-- 1 = dark title bar -->
    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DarkTitleBar">1</sys:Int32>

</ResourceDictionary>
